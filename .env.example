# Copy this file to an explicit runtime env file such as `.env.pska`, then pass
# it with `--env-file .env.pska` or `make ... ENV_FILE=.env.pska`.
# PSKA does not auto-load this file; missing providers still fail explicitly.

PSKA_RETRIEVAL_PROVIDER=ragflow
PSKA_KB_PROVIDER=ragflow
PSKA_MEMORY_PROVIDER=sqlite
PSKA_REVIEW_DB=/Users/xudawei/PSKA-Essential/.pska-essential/review.sqlite3
PSKA_MEMORY_DB=/Users/xudawei/PSKA-Essential/.pska-essential/memory.sqlite3
PSKA_GOVERNANCE_DURABLE_MEMORY=manual_review
PSKA_WORKSPACE_ID=default
PSKA_TENANT_ID=

# Hermes WebUI conversation recall for /api/conversation/context-pack.
# Install the provider patch with scripts/install_hermes_recall_provider.sh,
# then set the same secret in Hermes and PSKA runtime environments.
PSKA_HERMES_WEBUI_BASE_URL=http://127.0.0.1:8787
PSKA_HERMES_RECALL_TOKEN=
HERMES_WEBUI_PSKA_RECALL_TOKEN=
# Legacy password fallback is disabled by default. Enable only for temporary
# compatibility with an old Hermes WebUI checkout.
# PSKA_HERMES_LEGACY_RECALL_FALLBACK=1

# Local RAGFlow source backend from /Users/xudawei/PSKA-Components/ragflow.
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT=30
PSKA_DIAGNOSTICS_TIMEOUT=3

# Graphiti local Docker service from /Users/xudawei/PSKA-Components/graphiti.
# Optional. Use PSKA_MEMORY_PROVIDER=graphiti only when this service is healthy.
GRAPHITI_BASE_URL=http://127.0.0.1:8000
GRAPHITI_GROUP_ID=pska-essential

# Explicit local fake mode for tests/tool discovery only.
# PSKA_DEV_FAKE=1
# PSKA_RETRIEVAL_PROVIDER=fake
# PSKA_KB_PROVIDER=fake
# PSKA_MEMORY_PROVIDER=fake
