# Copy to .env in this directory before running docker compose.

# Repository locations. The defaults assume sibling folders under the same home:
#   ~/PSKA-Essential
#   ~/novel
#   ~/hermes-webui
PSKA_ESSENTIAL_REPO=../..
EIDOLIA_REPO=../../../novel
HERMES_WEBUI_REPO=../../../hermes-webui
# Optional apt-cacher-ng or other HTTP apt proxy for flaky Debian mirrors.
BUILD_APT_PROXY=

# WebUI is the only published service in the alpha compose stack.
HERMES_WEBUI_BIND=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_PASSWORD=change-me
HERMES_HOME=${HOME}/.hermes
HERMES_WORKSPACE=${HOME}/workspace
# Run `id -u` and `id -g`; these are the current macOS values on this machine.
WANTED_UID=502
WANTED_GID=20

# Live PSKA defaults. RAGFlow is external to this alpha stack.
PSKA_RETRIEVAL_PROVIDER=ragflow
PSKA_KB_PROVIDER=ragflow
PSKA_MEMORY_PROVIDER=sqlite
PSKA_GOVERNANCE_DURABLE_MEMORY=manual_review
PSKA_WORKSPACE_ID=default
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT=30
PSKA_DIAGNOSTICS_TIMEOUT=3

# Boot-only fake mode, for checking the UI and compose plumbing without RAGFlow.
# Do not use this as proof of live retrieval.
# PSKA_DEV_FAKE=1
# PSKA_RETRIEVAL_PROVIDER=fake
# PSKA_KB_PROVIDER=fake
# PSKA_MEMORY_PROVIDER=fake

# Eidolia generation through Hermes CLI is not part of alpha compose A.
NOVEL_MCP_AUTOSTART=false
HERMES_COMMAND=hermes
