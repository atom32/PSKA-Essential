# PSKA Full Compose v0
# Copy this file to .env and edit the required values before `./bootstrap.sh up`.

# Runtime location for cloned component repos, generated Hermes config, and data.
PSKA_SUITE_HOME=./.runtime
PSKA_FULL_PROJECT=pska-full
PSKA_FULL_IMAGE_TAG=local
PSKA_FULL_UPDATE_REPOS=0

# Source repositories. Defaults are suitable when starting from PSKA-Essential only.
PSKA_ESSENTIAL_REPO=../..
EIDOLIA_REPO=./.runtime/repos/novel
EIDOLIA_REPO_URL=https://github.com/atom32/novel.git
EIDOLIA_REF=main
HERMES_WEBUI_REPO=./.runtime/repos/hermes-webui
HERMES_WEBUI_REPO_URL=https://github.com/nesquena/hermes-webui.git
HERMES_WEBUI_REF=master
RAGFLOW_HOME=./.runtime/repos/ragflow
RAGFLOW_REPO_URL=https://github.com/infiniflow/ragflow.git
RAGFLOW_REF=v0.26.4

# Host access. If WebUI is exposed beyond localhost, set a real password.
HERMES_WEBUI_BIND=0.0.0.0
HERMES_WEBUI_PORT=8787
HERMES_WEBUI_PASSWORD=change-me
HERMES_GATEWAY_BIND=127.0.0.1
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=9119
HERMES_WEBUI_GATEWAY_USE_RUNS_API=true
HERMES_SKIP_CHMOD=1
HERMES_HOME_DIR=./.runtime/hermes-home
HERMES_WORKSPACE=./.runtime/workspace
# Run `id -u` and `id -g`.
WANTED_UID=1000
WANTED_GID=1000
BUILD_APT_PROXY=

# Hermes Agent and model defaults.
HERMES_AGENT_IMAGE=nousresearch/hermes-agent:latest
HERMES_MODEL_PROVIDER=deepseek
HERMES_MODEL_DEFAULT=deepseek-v4-flash
HERMES_MODEL_BASE_URL=https://api.deepseek.com/v1
HERMES_AGENT_MAX_TURNS=150
HERMES_GATEWAY_API_KEY=change-me-gateway-key
HERMES_WEBUI_CHAT_BACKEND=gateway
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SILICONFLOW_API_KEY=

# PSKA live defaults. Graphiti intentionally stays out of full-compose v0.
PSKA_RETRIEVAL_PROVIDER=ragflow
PSKA_KB_PROVIDER=ragflow
PSKA_MEMORY_PROVIDER=sqlite
PSKA_DEV_FAKE=
PSKA_GOVERNANCE_DURABLE_MEMORY=manual_review
PSKA_WORKSPACE_ID=default
PSKA_TENANT_ID=
RAGFLOW_BASE_URL=http://host.docker.internal:9380
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT=30
PSKA_DIAGNOSTICS_TIMEOUT=3

# Local embedding service. It is required for the full demo path and is started
# before RAGFlow. The default model is intentionally small enough for 16GB demo
# laptops; switch to BAAI/bge-m3 only when the machine has enough RAM.
EMBEDDING_ENABLED=1
EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_BIND=127.0.0.1
EMBEDDING_HOST_PORT=6380
# Leave empty to derive http://host.docker.internal:${EMBEDDING_HOST_PORT}.
RAGFLOW_TEI_BASE_URL=
RAGFLOW_EMBEDDING_PROFILE_MARKER=tei-cpu

# RAGFlow stack defaults. RAGFlow remains an upstream-owned compose project.
RAGFLOW_PROJECT=ragflow
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
DOC_ENGINE=elasticsearch
DEVICE=cpu
RAGFLOW_EXTRA_PROFILES=
RAGFLOW_HOST_PORT=9380
RAGFLOW_WEB_HTTP_PORT=8080
RAGFLOW_WEB_HTTPS_PORT=8443
RAGFLOW_ADMIN_PORT=9381
RAGFLOW_MCP_PORT=9382
RAGFLOW_GO_HTTP_PORT=9384
RAGFLOW_GO_ADMIN_PORT=9383
RAGFLOW_MYSQL_PORT=13306
RAGFLOW_REDIS_PORT=16379
RAGFLOW_MINIO_PORT=19000
RAGFLOW_MINIO_CONSOLE_PORT=19001
RAGFLOW_ES_PORT=19200
RAGFLOW_OS_PORT=19201
RAGFLOW_MEM_LIMIT=8073741824
RAGFLOW_REGISTER_ENABLED=1
RAGFLOW_MACOS=
TZ=Asia/Shanghai
HF_ENDPOINT=

# Change these before using the stack beyond a private demo network.
RAGFLOW_MYSQL_PASSWORD=pska_full_mysql_change_me
RAGFLOW_REDIS_PASSWORD=pska_full_redis_change_me
RAGFLOW_MINIO_USER=rag_flow
RAGFLOW_MINIO_PASSWORD=pska_full_minio_change_me
RAGFLOW_ELASTIC_PASSWORD=pska_full_elastic_change_me
RAGFLOW_OPENSEARCH_PASSWORD=PskA_full_OpenSearch_01!

# Eidolia generation through Hermes CLI is not fully containerized in v0.
NOVEL_MCP_AUTOSTART=false
HERMES_COMMAND=hermes
