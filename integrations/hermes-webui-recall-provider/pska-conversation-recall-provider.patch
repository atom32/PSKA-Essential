+
+
+def test_pska_conversation_import_creates_read_only_history_sessions(monkeypatch):
+    import api.auth as auth
+    import api.profiles as profiles
+    import api.routes as routes
+
+    saved = {}
+    published = []
+
+    class FakeSession:
+        def __init__(self, **kwargs):
+            self.__dict__.update(kwargs)
+
+        @classmethod
+        def load(cls, sid):
+            return saved.get(sid)
+
+        def save(self, touch_updated_at=True):
+            self.save_touch_updated_at = touch_updated_at
+            saved[self.session_id] = self
+
+        def compact(self):
+            return {
+                "session_id": self.session_id,
+                "title": self.title,
+                "profile": self.profile,
+                "message_count": len(self.messages),
+                "read_only": self.read_only,
+                "source_tag": self.source_tag,
+                "session_source": self.session_source,
+                "source_label": self.source_label,
+            }
+
+    monkeypatch.setattr(auth, "pska_recall_token_auth_ok", lambda _handler: True)
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+    monkeypatch.setattr(routes, "Session", FakeSession)
+    monkeypatch.setattr(routes, "SESSIONS", OrderedDict())
+    monkeypatch.setattr(routes, "LOCK", nullcontext())
+    monkeypatch.setattr(routes, "_evict_sessions_over_cap", lambda: 0)
+    monkeypatch.setattr(routes, "get_last_workspace", lambda: "/tmp/hermes-workspace")
+    monkeypatch.setattr(routes, "DEFAULT_MODEL", "test-model")
+    monkeypatch.setattr(routes, "_publish_session_list_changed", lambda reason, **kwargs: published.append((reason, kwargs)))
+    monkeypatch.setattr(routes, "j", lambda _handler, payload, status=200, extra_headers=None: payload)
+
+    payload = routes._handle_pska_conversations_import(
+        SimpleNamespace(headers={}),
+        {
+            "source": {
+                "kind": "chatgpt_export",
+                "label": "ChatGPT partial history",
+                "import_id": "cgconv_test",
+            },
+            "conversations": [
+                {
+                    "external_id": "chatgpt-1",
+                    "title": "PSKA history import",
+                    "created_at": "2026-08-20T10:00:00Z",
+                    "updated_at": "2026-08-20T10:02:00Z",
+                    "messages": [
+                        {
+                            "id": "m1",
+                            "role": "user",
+                            "content": "把 ChatGPT 对话导入成普通历史。",
+                            "created_at": "2026-08-20T10:00:00Z",
+                        },
+                        {
+                            "id": "m2",
+                            "role": "assistant",
+                            "content": "之后 PSKA 只做查询式召回。",
+                            "created_at": "2026-08-20T10:02:00Z",
+                        },
+                    ],
+                }
+            ],
+        },
+    )
+
+    assert routes._csrf_exempt_path("/api/pska/conversations/import") is True
+    assert payload["schema"] == "hermes.pska_conversation_history_import.v1"
+    assert payload["status"] == "imported"
+    assert payload["summary"]["imported_conversation_count"] == 1
+    assert payload["summary"]["message_count"] == 2
+    assert payload["returns_full_messages"] is False
+    item = payload["imported"][0]
+    assert "messages" not in item
+    imported_session = next(iter(saved.values()))
+    assert imported_session.read_only is True
+    assert imported_session.source_tag == "pska_chatgpt_import"
+    assert imported_session.session_source == "pska.chatgpt_export"
+    assert imported_session.messages[0]["role"] == "user"
+    assert imported_session.messages[0]["content"] == "把 ChatGPT 对话导入成普通历史。"
+    assert imported_session.save_touch_updated_at is False
+    assert published == [("pska_conversation_import", {"profile": "default"})]
