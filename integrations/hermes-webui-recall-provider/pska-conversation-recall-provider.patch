+def _handle_pska_conversations_search(handler, body):
+    from api.auth import pska_recall_token_auth_ok
+    from api.profiles import get_active_profile_name
+
+    if not pska_recall_token_auth_ok(handler):
+        return bad(handler, "PSKA conversation recall token required", 401)
+    if not isinstance(body, dict):
+        return bad(handler, "request body must be a JSON object", 400)
+    query = str(body.get("query") or body.get("user_message") or "").strip()
+    queries = _pska_recall_queries(body, query)
+    if not queries:
+        return bad(handler, "query is required", 400)
+    top_k = _bounded_request_int(body.get("top_k"), default=5, minimum=1, maximum=20)
+    depth = _bounded_request_int(body.get("depth"), default=0, minimum=0, maximum=200)
+    max_chars = _bounded_request_int(body.get("max_chars_per_item"), default=700, minimum=160, maximum=2000)
+    content_search = bool(body.get("content", True))
+    active_profile = get_active_profile_name()
+    all_profiles = bool(body.get("all_profiles")) and not _is_isolated_profile_mode()
+    sessions = all_sessions()
+    if not all_profiles:
+        sessions = [
+            s for s in sessions
+            if _profiles_match(s.get("profile"), active_profile)
+        ]
+    try:
+        redact_enabled = bool(load_settings().get("api_redact_enabled", True))
+    except Exception:
+        redact_enabled = True
+
+    items: list[dict] = []
+    seen: set[str] = set()
+    for session_row in sessions:
+        session_id = str(session_row.get("session_id") or "").strip()
+        if not session_id:
+            continue
+        title = str(session_row.get("title") or "Untitled").strip()
+        title_query = _first_matching_query(title, queries)
+        matched_content = False
+        if content_search:
+            try:
+                session = get_session_for_scan(session_id)
+                if session is not None:
+                    messages = session.messages[:depth] if depth else session.messages
+                    for position, message in enumerate(messages, start=1):
+                        if not isinstance(message, dict):
+                            continue
+                        text = _session_search_message_text(message)
+                        matched_query = _first_matching_query(text, queries)
+                        if not matched_query:
+                            continue
+                        item = _pska_recall_item_from_message(
+                            session_row,
+                            message,
+                            matched_query,
+                            position=position,
+                            index=len(items) + 1,
+                            max_chars=max_chars,
+                            redact_enabled=redact_enabled,
+                        )
+                        key = _pska_recall_item_key(item)
+                        if key not in seen:
+                            seen.add(key)
+                            items.append(item)
+                            matched_content = True
+                        break
+            except Exception:
+                logger.debug("PSKA conversation recall scan failed for session %s", session_id, exc_info=True)
+        if not matched_content and title_query:
+            item = _pska_recall_item_from_title(
+                session_row,
+                title_query,
+                index=len(items) + 1,
+                max_chars=max_chars,
+                redact_enabled=redact_enabled,
+            )
+            key = _pska_recall_item_key(item)
+            if key not in seen:
+                seen.add(key)
+                items.append(item)
+        if len(items) >= top_k:
+            break
+
+    return j(handler, {
+        "ok": True,
+        "schema": "hermes.pska_conversation_recall.v1",
+        "query": query,
+        "queries": queries,
+        "items": items[:top_k],
+        "count": min(len(items), top_k),
+        "all_profiles": all_profiles,
+        "active_profile": active_profile,
+        "bounded": True,
+    })
+
+
+def _pska_recall_queries(body: dict, query: str) -> list[str]:
+    raw_queries = body.get("queries")
+    candidates = [query]
+    if isinstance(raw_queries, list):
+        candidates.extend(str(item or "") for item in raw_queries)
+    result: list[str] = []
+    for candidate in candidates:
+        normalized = re.sub(r"\s+", " ", str(candidate or "")).strip()
+        if len(normalized) < 2 or normalized in result:
+            continue
+        result.append(normalized)
+        if len(result) >= 8:
+            break
+    return result
+
+
+def _bounded_request_int(value, *, default: int, minimum: int, maximum: int) -> int:
+    try:
+        parsed = int(value)
+    except (TypeError, ValueError):
+        parsed = default
+    return max(minimum, min(maximum, parsed))
+
+
+def _first_matching_query(text, queries: list[str]) -> str:
+    normalized = str(text or "").lower()
+    for query in queries:
+        if query.lower() in normalized:
+            return query
+    return ""
+
+
+def _pska_recall_item_from_title(session_row: dict, query: str, *, index: int, max_chars: int, redact_enabled: bool) -> dict:
+    title = _redact_text(str(session_row.get("title") or "Untitled"), _enabled=redact_enabled)
+    return {
+        "source": "hermes.conversation",
+        "index": index,
+        "session_id": str(session_row.get("session_id") or ""),
+        "message_id": "",
+        "title": title,
+        "role": "",
+        "snippet": _truncate_recall_text(title, max_chars),
+        "match_type": "title",
+        "matched_query": query,
+        "created_at": session_row.get("created_at"),
+        "updated_at": session_row.get("updated_at") or session_row.get("last_message_at"),
+        "score": 0.62,
+    }
+
+
+def _pska_recall_item_from_message(
+    session_row: dict,
+    message: dict,
+    query: str,
+    *,
+    position: int,
+    index: int,
+    max_chars: int,
+    redact_enabled: bool,
+) -> dict:
+    text = _session_search_message_text(message)
+    preview = _session_search_preview(text, query, max_len=max_chars) or _truncate_recall_text(text, max_chars)
+    title = _redact_text(str(session_row.get("title") or "Untitled"), _enabled=redact_enabled)
+    return {
+        "source": "hermes.conversation",
+        "index": index,
+        "session_id": str(session_row.get("session_id") or ""),
+        "message_id": str(message.get("id") or message.get("message_id") or f"{session_row.get('session_id')}:m{position}"),
+        "title": title,
+        "role": str(message.get("role") or ""),
+        "snippet": _redact_text(preview, _enabled=redact_enabled),
+        "match_type": "content",
+        "matched_query": query,
+        "created_at": message.get("created_at") or message.get("timestamp"),
+        "updated_at": session_row.get("updated_at") or session_row.get("last_message_at"),
+        "score": 0.78,
+    }
+
+
+def _pska_recall_item_key(item: dict) -> str:
+    return "|".join(
+        [
+            str(item.get("session_id") or ""),
+            str(item.get("message_id") or ""),
+            str(item.get("match_type") or ""),
+            str(item.get("snippet") or "")[:160],
+        ]
+    )
+
+
+def _truncate_recall_text(value, max_chars: int) -> str:
+    text = re.sub(r"\s+", " ", str(value or "")).strip()
+    if len(text) <= max_chars:
+        return text
+    return text[: max(0, max_chars - 3)].rstrip() + "..."
+
+
