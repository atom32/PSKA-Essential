@@ -17037,0 +17051,222 @@ def _handle_pska_conversations_search(handler, body):
+# PSKA provider schema pair:
+# - search: hermes.pska_conversation_recall.v1
+# - import: hermes.pska_conversation_history_import.v1
+def _handle_pska_conversations_import(handler, body):
+    from api.auth import pska_recall_token_auth_ok
+    from api.profiles import get_active_profile_name
+
+    if not pska_recall_token_auth_ok(handler):
+        return bad(handler, "PSKA conversation import token required", 401)
+    if not isinstance(body, dict):
+        return bad(handler, "request body must be a JSON object", 400)
+    conversations = body.get("conversations")
+    if not isinstance(conversations, list):
+        return bad(handler, "conversations must be a list", 400)
+    limit = _bounded_request_int(
+        body.get("conversation_limit") or body.get("limit") or len(conversations) or 1,
+        default=min(len(conversations) or 1, 20),
+        minimum=1,
+        maximum=200,
+    )
+    source = body.get("source") if isinstance(body.get("source"), dict) else {}
+    source_kind = _truncate_recall_text(source.get("kind") or body.get("source_kind") or "external_conversation_import", 80)
+    source_label = _truncate_recall_text(source.get("label") or body.get("source_label") or "Imported conversation history", 160)
+    import_id = _truncate_recall_text(source.get("import_id") or body.get("import_id") or "", 96)
+    overwrite = bool(body.get("overwrite", False))
+    read_only = bool(body.get("read_only", True))
+    active_profile = get_active_profile_name()
+    imported: list[dict] = []
+    skipped: list[dict] = []
+
+    for index, conversation in enumerate(conversations[:limit], start=1):
+        if not isinstance(conversation, dict):
+            skipped.append({"index": index, "reason": "conversation_not_object"})
+            continue
+        normalized = _pska_import_normalized_conversation(conversation, index=index)
+        if not normalized["messages"]:
+            skipped.append(
+                {
+                    "index": index,
+                    "external_id": normalized["external_id"],
+                    "title": normalized["title"],
+                    "reason": "no_supported_messages",
+                }
+            )
+            continue
+        session_id = _pska_import_session_id(normalized, import_id=import_id)
+        existing = Session.load(session_id)
+        if existing is not None and not overwrite:
+            skipped.append(
+                {
+                    "index": index,
+                    "session_id": session_id,
+                    "external_id": normalized["external_id"],
+                    "title": normalized["title"],
+                    "reason": "duplicate_session",
+                }
+            )
+            continue
+        session = Session(
+            session_id=session_id,
+            title=normalized["title"],
+            workspace=str(get_last_workspace()),
+            model=DEFAULT_MODEL,
+            messages=normalized["messages"],
+            created_at=normalized["created_at"],
+            updated_at=normalized["updated_at"],
+            profile=active_profile,
+            source_tag="pska_chatgpt_import" if source_kind == "chatgpt_export" else "pska_conversation_import",
+            raw_source=source_kind,
+            session_source=f"pska.{source_kind}",
+            source_label=source_label,
+            read_only=read_only,
+            manual_title=True,
+        )
+        with LOCK:
+            SESSIONS[session.session_id] = session
+            SESSIONS.move_to_end(session.session_id)
+            _evict_sessions_over_cap()
+        session.save(touch_updated_at=False)
+        imported.append(
+            {
+                "index": index,
+                "session_id": session.session_id,
+                "external_id": normalized["external_id"],
+                "title": session.title,
+                "message_count": len(session.messages),
+                "created_at": session.created_at,
+                "updated_at": session.updated_at,
+                "read_only": session.read_only,
+                "profile": session.profile,
+            }
+        )
+
+    if imported:
+        _publish_session_list_changed(
+            "pska_conversation_import",
+            profile=active_profile,
+        )
+
+    return j(handler, {
+        "ok": True,
+        "schema": "hermes.pska_conversation_history_import.v1",
+        "status": "imported" if imported else "empty",
+        "source": {
+            "kind": source_kind,
+            "label": source_label,
+            "import_id": import_id,
+        },
+        "summary": {
+            "received_conversation_count": len(conversations),
+            "selected_conversation_count": min(limit, len(conversations)),
+            "imported_conversation_count": len(imported),
+            "skipped_conversation_count": len(skipped),
+            "message_count": sum(int(item.get("message_count") or 0) for item in imported),
+        },
+        "imported": imported[:50],
+        "imported_truncated": len(imported) > 50,
+        "skipped": skipped[:50],
+        "skipped_truncated": len(skipped) > 50,
+        "active_profile": active_profile,
+        "bounded": True,
+        "returns_full_messages": False,
+    })
+
+
+def _pska_import_normalized_conversation(conversation: dict, *, index: int) -> dict:
+    external_id = str(
+        conversation.get("external_id")
+        or conversation.get("conversation_id")
+        or conversation.get("id")
+        or f"conversation-{index}"
+    ).strip()
+    title = _truncate_recall_text(conversation.get("title") or external_id or f"Imported conversation {index}", 120)
+    created_at = _pska_import_timestamp(
+        conversation.get("created_at") or conversation.get("create_time") or conversation.get("created"),
+        fallback=time.time(),
+    )
+    updated_at = _pska_import_timestamp(
+        conversation.get("updated_at") or conversation.get("update_time") or conversation.get("updated"),
+        fallback=created_at,
+    )
+    messages = []
+    for message_index, raw_message in enumerate(conversation.get("messages") or [], start=1):
+        normalized = _pska_import_normalized_message(raw_message, fallback_timestamp=created_at)
+        if not normalized:
+            continue
+        normalized.setdefault("id", f"{external_id}:m{message_index}")
+        messages.append(normalized)
+    if messages:
+        updated_at = max(
+            updated_at,
+            max(_pska_import_timestamp(item.get("timestamp"), fallback=updated_at) for item in messages),
+        )
+    return {
+        "external_id": external_id,
+        "title": title,
+        "created_at": created_at,
+        "updated_at": updated_at,
+        "messages": messages,
+    }
+
+
+def _pska_import_normalized_message(message, *, fallback_timestamp: float) -> dict | None:
+    if not isinstance(message, dict):
+        return None
+    role = str(message.get("role") or "unknown").strip().lower()
+    if role not in {"system", "user", "assistant", "tool"}:
+        return None
+    content = _session_search_message_text(message)
+    if not content:
+        content = str(message.get("text") or message.get("snippet") or "").strip()
+    if not content:
+        return None
+    timestamp = _pska_import_timestamp(
+        message.get("timestamp") or message.get("created_at") or message.get("create_time"),
+        fallback=fallback_timestamp,
+    )
+    result = {
+        "role": role,
+        "content": content,
+        "timestamp": timestamp,
+    }
+    message_id = str(message.get("id") or message.get("message_id") or "").strip()
+    if message_id:
+        result["id"] = message_id
+    return result
+
+
+def _pska_import_timestamp(value, *, fallback: float) -> float:
+    if isinstance(value, (int, float)) and value > 0:
+        return float(value)
+    text = str(value or "").strip()
+    if not text:
+        return float(fallback)
+    try:
+        parsed = float(text)
+        if parsed > 0:
+            return parsed
+    except (TypeError, ValueError):
+        pass
+    try:
+        normalized = text[:-1] + "+00:00" if text.endswith("Z") else text
+        parsed_dt = datetime.datetime.fromisoformat(normalized)
+        if parsed_dt.tzinfo is None:
+            parsed_dt = parsed_dt.replace(tzinfo=datetime.timezone.utc)
+        return float(parsed_dt.timestamp())
+    except (TypeError, ValueError):
+        return float(fallback)
+
+
+def _pska_import_session_id(conversation: dict, *, import_id: str) -> str:
+    basis = "|".join(
+        [
+            "pska-conversation-import",
+            import_id,
+            str(conversation.get("external_id") or ""),
+            str(conversation.get("title") or ""),
+        ]
+    )
+    digest = hashlib.sha256(basis.encode("utf-8")).hexdigest()[:20]
+    return f"pska_cg_{digest}"
+
