+from types import SimpleNamespace
+
+
+def _invoke_recall(monkeypatch, body, *, active_profile="default"):
+    import api.auth as auth
+    import api.profiles as profiles
+    import api.routes as routes
+
+    sessions_meta = [
+        {
+            "session_id": "default-s",
+            "title": "PSKA context pack planning",
+            "profile": "default",
+            "updated_at": "2026-08-23T08:00:00Z",
+        },
+        {
+            "session_id": "other-s",
+            "title": "private needle outside active profile",
+            "profile": "other",
+            "updated_at": "2026-08-23T09:00:00Z",
+        },
+    ]
+    sessions = {
+        "default-s": SimpleNamespace(messages=[
+            {
+                "id": "m1",
+                "role": "user",
+                "content": "PSKA should own data flow while the WebUI extension stays as a control plane.",
+                "created_at": "2026-08-23T08:01:00Z",
+            }
+        ]),
+        "other-s": SimpleNamespace(messages=[
+            {
+                "id": "m2",
+                "role": "user",
+                "content": "needle should not leak into the default profile search result.",
+                "created_at": "2026-08-23T09:01:00Z",
+            }
+        ]),
+    }
+
+    monkeypatch.setattr(auth, "pska_recall_token_auth_ok", lambda _handler: True)
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: active_profile)
+    monkeypatch.setattr(routes, "all_sessions", lambda: list(sessions_meta))
+    monkeypatch.setattr(routes, "get_session_for_scan", lambda sid: sessions.get(sid))
+    monkeypatch.setattr(routes, "_is_isolated_profile_mode", lambda: False)
+    monkeypatch.setattr(routes, "load_settings", lambda: {"api_redact_enabled": False})
+    monkeypatch.setattr(routes, "j", lambda _handler, payload, status=200, extra_headers=None: payload)
+
+    return routes._handle_pska_conversations_search(SimpleNamespace(headers={}), body)
+
+
+def test_pska_recall_provider_returns_bounded_conversation_snippets(monkeypatch):
+    import api.routes as routes
+
+    payload = _invoke_recall(
+        monkeypatch,
+        {
+            "query": "PSKA",
+            "queries": ["PSKA", "control plane"],
+            "top_k": 3,
+            "content": True,
+            "max_chars_per_item": 240,
+        },
+    )
+
+    assert routes._csrf_exempt_path("/api/pska/conversations/search") is True
+    assert payload["schema"] == "hermes.pska_conversation_recall.v1"
+    assert payload["count"] == 1
+    item = payload["items"][0]
+    assert item["source"] == "hermes.conversation"
+    assert item["session_id"] == "default-s"
+    assert item["message_id"] == "m1"
+    assert item["match_type"] == "content"
+    assert "control plane" in item["snippet"]
+    assert "messages" not in item
+
+
+def test_pska_recall_provider_scopes_to_active_profile_by_default(monkeypatch):
+    payload = _invoke_recall(
+        monkeypatch,
+        {
+            "query": "needle",
+            "queries": ["needle"],
+            "top_k": 3,
+            "content": True,
+        },
+    )
+
+    assert payload["count"] == 0
+    assert payload["items"] == []
+    assert payload["active_profile"] == "default"
+
+
+def test_pska_recall_provider_can_opt_into_all_profiles_when_not_isolated(monkeypatch):
+    payload = _invoke_recall(
+        monkeypatch,
+        {
+            "query": "needle",
+            "queries": ["needle"],
+            "top_k": 3,
+            "content": True,
+            "all_profiles": True,
+        },
+    )
+
+    assert payload["count"] == 1
+    assert payload["items"][0]["session_id"] == "other-s"
+    assert payload["all_profiles"] is True
