+def pska_recall_token_auth_ok(handler) -> bool:
+    token = os.getenv(_PSKA_RECALL_TOKEN_ENV, '').strip()
+    if len(token) < 16:
+        return False
+    try:
+        from api.routes import _raw_peer_is_trusted_proxy
+
+        if not _raw_peer_is_trusted_proxy(handler):
+            return False
+    except Exception:
+        return False
+    supplied = str(handler.headers.get('X-PSKA-Recall-Token') or '').strip()
+    if not supplied:
+        authorization = str(handler.headers.get('Authorization') or '').strip()
+        if authorization.lower().startswith('bearer '):
+            supplied = authorization[7:].strip()
+    if len(supplied) > 4096:
+        return False
+    return bool(supplied and hmac.compare_digest(supplied, token))
+
